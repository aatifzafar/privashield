# Root reference configuration. Copy values into frontend/.env and/or backend/.env.

# Frontend
VITE_API_URL=http://127.0.0.1:8000

# Backend
PRIVASHIELD_STORAGE_DIR=.local/privashield-sessions
PRIVASHIELD_SESSION_TTL_SECONDS=900
PRIVASHIELD_KEEP_LAST_N=3
PRIVASHIELD_RATE_LIMIT_PER_MINUTE=60
PRIVASHIELD_TESSERACT_CMD=
PRIVASHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
